# 复制为 .env 后按需修改。compose 与容器共用这一个文件。
# ⚠️ .env 已在 .gitignore 中，不要提交。

# ---------- 数据库 ----------
POSTGRES_USER=wardrobe
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=wardrobe

# ---------- 对外端口（宿主机） ----------
WARDROBE_PORT=43470

# ---------- 应用配置（统一 WARDROBE_ 前缀）----------

# 至少 32 字节。生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
WARDROBE_JWT_SECRET=change-me-at-least-32-bytes-random-string

# access token 有效期（分钟） / refresh token 有效期（天）
WARDROBE_ACCESS_TOKEN_MINUTES=30
WARDROBE_REFRESH_TOKEN_DAYS=30

# 是否开放自助注册。单人使用建议 false，账号用 CLI 或下面的 bootstrap 创建
WARDROBE_ALLOW_REGISTRATION=false

# 首次启动时自动创建的管理员（幂等，同名已存在则跳过）
WARDROBE_BOOTSTRAP_USERNAME=naonao
WARDROBE_BOOTSTRAP_PASSWORD=change-me-admin-password

# 媒体文件根目录（容器内路径，对应 media-data 卷）
WARDROBE_MEDIA_ROOT=/data/media

# 开发期前端地址，逗号分隔
WARDROBE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

WARDROBE_DEBUG=false

# ---------- 构建期镜像源（可选）----------
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com

# ---------- 镜像 tag ----------
WARDROBE_TAG=dev
